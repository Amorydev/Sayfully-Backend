# Feature flags
AI_ENABLED=False
# Gia sư AI — provider: mock (trả lời mẫu, không cần key) | openai_compat (DeepSeek / OpenRouter)
AI_PROVIDER=mock
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash
AI_FALLBACK_MODEL=            # ví dụ openai/gpt-4o-mini; trống = không thử lại model khác
