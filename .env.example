AI_FREE_TURNS=20
AI_PREMIUM_TURNS=200

# AI riêng cho xử lý VIDEO (dịch phụ đề, ước lượng CEFR) — trống thì dùng lại AI_* ở trên
VIDEO_AI_PROVIDER=
VIDEO_AI_BASE_URL=
VIDEO_AI_MODEL=
VIDEO_AI_FALLBACK_MODEL=
VIDEO_AI_API_KEY=
VIDEO_AI_TIMEOUT=90
SENTRY_DSN=

# Play Integrity (diem game): off | log | enforce. Service account can quyen Play Integrity API.
PLAY_INTEGRITY_MODE=log
PLAY_INTEGRITY_PACKAGE_NAME=amoryzenith.sayfully.app
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Video YouTube người dùng thêm (Premium)
VIDEO_IMPORT_ENABLED=True
VIDEO_IMPORT_MAX_SEC=1200
VIDEO_IMPORT_DAILY_LIMIT=5
# True: xử lý ngay trong request thay vì qua django-q (tiện khi dev, không chạy qcluster)
VIDEO_IMPORT_SYNC=True
